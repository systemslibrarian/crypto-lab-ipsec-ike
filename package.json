{
  "name": "crypto-lab-ipsec-ike",
  "private": true,
  "version": "0.1.0",
  "description": "Executable bounded IKEv2 and ESP lesson for policy, key derivation, replay protection, and rekeying",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "test:claims": "playwright test claims.spec.ts",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:mutations": "node scripts/claim-mutations.mjs",
    "ci": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/crypto-lab-ipsec-ike.git"
  },
  "homepage": "https://systemslibrarian.github.io/crypto-lab-ipsec-ike/",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
